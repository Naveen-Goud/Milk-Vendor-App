# Copy this file to .env and fill in with your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Required — the app
# has no offline/local mode; without these it shows a "not configured" screen.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
